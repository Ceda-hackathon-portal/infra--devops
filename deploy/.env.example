# Copy to deploy/.env on the server (chmod 600). Never commit the real .env.

# Public host name. Caddy fetches a Let's Encrypt certificate for it automatically.
# For a laptop rehearsal use SITE_ADDRESS=:80 with HTTP_PORT=8088.
SITE_ADDRESS=ceda.example.com

# Host ports published by caddy (only change these for a local rehearsal).
HTTP_PORT=80
HTTPS_PORT=443

# Path to the front-end checkout, relative to this deploy/ folder.
FRONTEND_DIR=../../front-end

# Leave empty: the browser calls /api/v1 on the same origin, which Caddy routes to the backend.
VITE_API_URL=
